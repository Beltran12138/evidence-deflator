# Python
__pycache__/
*.py[cod]
*$py.class

# Build / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Test / cache
.pytest_cache/
.cache/
htmlcov/
.coverage

# Virtualenvs
.venv/
venv/
env/

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Secrets — never commit
.env
.env.*
*.key
*.pem

# Calibration working data — third-party datasets and captured vendor payloads.
# Licences differ per dataset and captures are large and perishable; the repo
# ships the harness, not the corpus.
.data/

# Live venue snapshots are regenerated by tools/fetch_okx.py; they go stale
# within minutes and are not a fixture.
corpus/

# Generated reports. tools/report.py writes here by convention; the page is a
# function of the corpus and the seed, so tracking it would only ever produce
# diffs that say the timestamp changed.
out/

# Hand-kept backups of earlier demo pages. The tracked file supersedes them
# and git already holds its history, so these stay local.
*.bak

# Hyperliquid board cache (CI)
.hlcache/
.rankcache/

# personal contact image used by the local deck export only
docs/assets/wechat-qr.png
